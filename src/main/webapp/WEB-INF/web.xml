<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Coffee Management System</display-name>

    <!-- Сервлеты для управления кофе -->
    <servlet>
        <servlet-name>CoffeeServlet</servlet-name>
        <servlet-class>com.example.servlets.CoffeeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AddCoffeeServlet</servlet-name>
        <servlet-class>com.example.servlets.AddCoffeeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EditCoffeeServlet</servlet-name>
        <servlet-class>com.example.servlets.EditCoffeeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>DeleteCoffeeServlet</servlet-name>
        <servlet-class>com.example.servlets.DeleteCoffeeServlet</servlet-class>
    </servlet>

    <!-- Сервлеты для упаковки фургона и поиска -->
    <servlet>
        <servlet-name>PackVanServlet</servlet-name>
        <servlet-class>com.example.servlets.PackVanServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>FindCoffeeServlet</servlet-name>
        <servlet-class>com.example.servlets.FindCoffeeServlet</servlet-class>
    </servlet>

    <!-- Маппинг сервлетов -->
    <servlet-mapping>
        <servlet-name>CoffeeServlet</servlet-name>
        <url-pattern>/coffees</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AddCoffeeServlet</servlet-name>
        <url-pattern>/add-coffee</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EditCoffeeServlet</servlet-name>
        <url-pattern>/edit-coffee</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DeleteCoffeeServlet</servlet-name>
        <url-pattern>/delete-coffee</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>PackVanServlet</servlet-name>
        <url-pattern>/pack-van</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FindCoffeeServlet</servlet-name>
        <url-pattern>/find-coffee</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>